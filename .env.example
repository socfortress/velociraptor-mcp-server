# Velociraptor MCP Server Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration (if using with OpenAI assistants)
# OPENAI_API_KEY=your-openai-api-key-here

# Velociraptor Server Configuration
VELOCIRAPTOR_API_KEY=/path/to/api.config.yaml
VELOCIRAPTOR_SSL_VERIFY=false
VELOCIRAPTOR_TIMEOUT=30          # upper bound for any query
VELOCIRAPTOR_MAX_ROWS=1000       # row cap for any query

# MCP Server Configuration
MCP_TRANSPORT=stdio              # or http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
# MCP_AUTH_TOKEN=                 # required for http: openssl rand -hex 32
# MCP_MAX_OUTPUT_CHARS=32000

# Logging Configuration
LOG_LEVEL=INFO

# Tool Filtering (optional)
# VELOCIRAPTOR_DISABLED_TOOLS=ListLinuxArtifactsTool
# VELOCIRAPTOR_DISABLED_CATEGORIES=collections   # auth, clients, vql, artifacts, collections, hunts
# VELOCIRAPTOR_READ_ONLY=false                   # true drops RunVQLQueryTool and CollectArtifactTool
